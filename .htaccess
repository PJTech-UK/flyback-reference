# Defensive only. The document root is meant to be web-php/public — if it is set
# correctly this file is never consulted, because nothing above it is reachable.
#
# Shared hosting frequently forces the document root to be the account's
# public_html, and a repository dropped in there wholesale would otherwise expose
# database.sqlite, the dataset and the source. Deny everything here, and let
# web-php/public/.htaccess allow the one directory that is meant to be served.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
